PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Leave AI_API_KEY empty to use the deterministic mock conversation flow.
# Gemini uses the Gemini generateContent API. For another provider, set
# AI_PROVIDER=openai-compatible and optionally configure LLM_BASE_URL.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-flash-latest


# Qloo REST API (server-side only). `auto` uses local mocks with no key and
# switches to live Qloo requests as soon as QLOO_API_KEY is provided.
QLOO_MODE=auto
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
